# Railway Postgres eklenince referans ver: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:pass@host:5432/db

# Panele giriş şifren (değiştirince tüm oturumlar kapanır)
APP_PASSWORD=buraya-guclu-bir-sifre

# Rastgele uzun bir metin
AUTH_SECRET=rastgele-uzun-bir-metin

# API anahtarları (sadece Railway'de gir, kimseyle paylaşma)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modeller (değiştirilebilir)
CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-6.1-sol

# İki yapay zekâ arasında en fazla kaç ek tur
MAX_AI_TURNS=2

# Günlük çağrı sınırı: 0 = sınırsız (varsayılan)
DAILY_CALL_LIMIT=0

# Tek model çağrısı zaman aşımı (ms)
AI_TIMEOUT_MS=300000

# Araçlar (varsayılan açık; sorun çıkarsa false yap)
TOOLS_WEB=true
TOOLS_CODE=true
TOOLS_GITHUB=true

# GitHub okuma (opsiyonel). Token yoksa açık repolar yine okunur; dosya listesi için token gerekebilir.
GITHUB_DEFAULT_REPO=bizbiraileyiz/ekip-panel
GITHUB_TOKEN=
